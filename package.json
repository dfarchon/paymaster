{
  "name": "@dfarchon/paymaster",
  "version": "0.1.0",
  "type": "module",
  "main": "./dist/index.js",
  "types": "./dist/index.d.ts",
  "bin": {
    "paymaster": "./dist/cli.js",
    "paymaster-fund": "./dist/fund-cli.js"
  },
  "exports": {
    ".": {
      "types": "./dist/index.d.ts",
      "import": "./dist/index.js"
    },
    "./artifact": {
      "types": "./dist/artifacts/SponsoredFpc.d.ts",
      "import": "./dist/artifacts/SponsoredFpc.js"
    }
  },
  "files": [
    "dist",
    "contracts",
    "Nargo.toml",
    "README.md"
  ],
  "scripts": {
    "build": "pnpm contract:build && tsc -p tsconfig.json",
    "contract:build": "aztec compile && aztec codegen ./target -o ./target --force && mkdir -p ./src/artifacts && cp ./target/SponsoredFpc.ts ./target/sponsored_fpc-SponsoredFpc.json ./src/artifacts/",
    "contract:test": "aztec-nargo test --workspace",
    "claim-ui": "tsx examples/claim-ui/server.ts",
    "counter-ui": "tsx examples/counter/app/server.ts",
    "format": "aztec-nargo fmt --workspace && prettier --write .",
    "format:check": "aztec-nargo fmt --workspace --check && prettier --check .",
    "test": "pnpm contract:test && tsx --test test/*.test.ts"
  },
  "dependencies": {
    "@aztec-labs/aztec.js": "6.0.0",
    "@aztec-labs/entrypoints": "6.0.0",
    "@aztec-labs/ethereum": "6.0.0",
    "@aztec-labs/foundation": "6.0.0",
    "@aztec-labs/noir-contracts.js": "6.0.0",
    "@aztec-labs/stdlib": "6.0.0",
    "@aztec-labs/wallets": "6.0.0",
    "viem": "2.38.2"
  },
  "devDependencies": {
    "@types/node": "24.10.7",
    "prettier": "3.7.4",
    "tsx": "4.21.0",
    "typescript": "5.9.3"
  },
  "engines": {
    "node": "24.22.1",
    "pnpm": "10.28.0"
  },
  "packageManager": "pnpm@10.28.0"
}
